[node name="gEndingText" type="CanvasLayer" parent="." unique_id=847876172]

[node name="Text1" type="Label" parent="gEndingText" unique_id=1522599214]
visible = false
offset_left = 37.0
offset_top = 211.0
offset_right = 1109.0
offset_bottom = 408.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 64
text = "You manage to group up with everyone.

contemplating if you guys should 
continue walking."
horizontal_alignment = 1

[node name="Text2" type="Label" parent="gEndingText" unique_id=2082710803]
visible = false
offset_left = 37.0
offset_top = 211.0
offset_right = 1109.0
offset_bottom = 408.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 64
text = "for a quick second you managed to get
glimpse of the bus.

but that was more than enough..."
horizontal_alignment = 1
metadata/_edit_use_anchors_ = true

[node name="Text3" type="Label" parent="gEndingText" unique_id=1261598887]
visible = false
offset_left = 37.0
offset_top = 211.0
offset_right = 1109.0
offset_bottom = 408.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 64
text = "you and your group decide it's best 
to  leave and go home"
horizontal_alignment = 1

[node name="Text4" type="Label" parent="gEndingText" unique_id=835447493]
visible = false
offset_left = 37.0
offset_top = 211.0
offset_right = 1109.0
offset_bottom = 408.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 64
text = "Even though it was a long journey.

Waking up early, paying the money to
get here, and pushing through all of 
those people..."
horizontal_alignment = 1

[node name="Text5" type="Label" parent="gEndingText" unique_id=350603278]
visible = false
offset_left = 5.0
offset_top = 226.0
offset_right = 1149.0
offset_bottom = 573.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 64
text = "The idea of seeing that 
bus was a dream"
horizontal_alignment = 1

[node name="Text6" type="Label" parent="gEndingText" unique_id=997704044]
visible = false
offset_left = 16.0
offset_top = 148.0
offset_right = 1152.0
offset_bottom = 495.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 64
text = "what made it fun and exciting?

maybe it was that vision in all of our
heads.

and the journey that helped fuel 
that excitement"
horizontal_alignment = 1

[node name="Text7" type="Label" parent="gEndingText" unique_id=325051063]
visible = false
offset_left = 37.0
offset_top = 211.0
offset_right = 1109.0
offset_bottom = 408.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 64
text = "so what if we didn't see jalen brunson

or kat or anyone..."
horizontal_alignment = 1

[node name="Text8" type="Label" parent="gEndingText" unique_id=788452205]
visible = false
offset_left = 37.0
offset_top = 420.0
offset_right = 1133.0
offset_bottom = 617.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 64
text = "a lot of these people also felt the
same. Just happy and enjoying the time
they had. it was a special moment."
horizontal_alignment = 1

[node name="Text9" type="Label" parent="gEndingText" unique_id=237984638]
visible = false
offset_left = 20.0
offset_top = 415.0
offset_right = 1140.0
offset_bottom = 612.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 64
text = "millions came, and a few saw. 
that small glimpse was so special,
it kept that hope and excitement alive."
horizontal_alignment = 1

[node name="Text10" type="Label" parent="gEndingText" unique_id=1530863849]
visible = false
offset_left = 19.0
offset_top = 380.0
offset_right = 1139.0
offset_bottom = 577.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 128
text = "it was fun"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Text11" type="Label" parent="gEndingText" unique_id=141683592]
visible = false
offset_left = 20.0
offset_top = 413.0
offset_right = 1140.0
offset_bottom = 610.0
theme_override_fonts/font = ExtResource("11_q0vil")
theme_override_font_sizes/font_size = 64
text = "you still have a lot of time left..."
horizontal_alignment = 1
vertical_alignment = 1

[node name="Text12" type="Label" parent="gEndingText" unique_id=1944698112]
visible = false
offset_left = 20.0
